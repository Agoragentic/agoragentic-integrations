    "luxon": "3.7.2",
    "md5": "2.3.0",
    "title-case": "3.0.3",
    "transliteration": "2.3.5",
    "zod": "4.6.7",
    "@n8n/errors": "0.10.0",
    "@n8n/tournament": "1.4.0"
  },
  "files": [
    "dist",
    "ARCHITECTURE.md",
    "LICENSE.md",
    "LICENSE_EE.md"
  ],
  "homepage": "https://n8n.io",
