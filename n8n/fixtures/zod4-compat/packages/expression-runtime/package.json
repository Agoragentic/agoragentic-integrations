{
  "name": "@n8n/expression-runtime",
  "version": "0.19.1",
  "description": "Secure, isolated expression evaluation runtime for n8n",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
